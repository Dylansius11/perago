# Copy to .env locally. Do not commit .env or paste its values into chat, issues, logs, or PRs.
# Never add a seed phrase, private key, session key, or recovery material.

# BSC Testnet Node API URL. It may contain an Alchemy API key; keep the populated value local.
PERAGO_BSC_TESTNET_RPC=

# BSC Mainnet Node API URL, used only by read-only mainnet-fork tests; never a
# transaction target. The same Alchemy app works with the bnb-mainnet host.
PERAGO_BSC_MAINNET_RPC=

# BSC Testnet Bundler API URL. For Alchemy BNB Testnet, use the same app
# endpoint as the Node API URL; it may contain an API key, so keep it local.
PERAGO_ALCHEMY_BUNDLER_RPC=

# Alchemy Gas Manager policy ID. P3-002 used owner-paid UserOperations and did
# not require this value. Before sponsoring later work, validate the current
# dashboard rules and allow only chain 97, smart account
# 0x17fcCe2B0C0cc44c4F88C6C09b6364a766Ee7944, and the exact approved call shape.
PERAGO_ALCHEMY_GAS_MANAGER_POLICY_ID=

# Public external EOA that owns the Modular Account V2. This is not a private key.
PERAGO_ROOT_OWNER_ADDRESS=

# Server-only OpenRouter key for the Space Bunny Alpha planner. Never paste
# live keys into chat or commit them. Free-tier goals may be retained or used
# by the provider; use only synthetic goals until privacy terms are confirmed.
PERAGO_OPENROUTER_API_KEY=

# 32-byte AES-256-GCM key (64 hex characters) that encrypts raw intent text at
# rest. Generate locally, for example:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
PERAGO_INTENT_ENCRYPTION_KEY=

# Disposable BSC Testnet deployer/probe key generated locally (0x-prefixed hex).
# Used only by the Foundry deploy script and the apps/executor live probes.
# Never reuse a wallet that holds real funds; never commit or paste this value.
PERAGO_DISPOSABLE_OWNER_KEY=

# Public address that receives a completed APEX job's payment. Set explicitly
# when deploying OutcomeEvaluator; do not substitute the executor session key.
PERAGO_SETTLEMENT_PROVIDER=

# Dedicated BSC Testnet faucet key. Fund only with the small tBNB faucet budget;
# it must never be a deployer, executor, owner, or session key.
PERAGO_FAUCET_KEY=
# Server-secret HMAC salt for the client IP ledger. Generate 32+ random bytes;
# never reuse or expose it.
PERAGO_FAUCET_IP_SALT=
# Faucet limits are base-unit wei and positive integers. Defaults: 0.02 tBNB
# per claim, 0.05 tBNB funded threshold, 1 tBNB rolling budget, one 24h window,
# and three claims/IP/window.
PERAGO_FAUCET_CLAIM_WEI=20000000000000000
PERAGO_FAUCET_FUNDED_THRESHOLD_WEI=50000000000000000
PERAGO_FAUCET_GLOBAL_BUDGET_WEI=1000000000000000000
PERAGO_FAUCET_CLAIM_WINDOW_SECONDS=86400
PERAGO_FAUCET_IP_CLAIM_LIMIT=3
# Set true only behind a proxy that overwrites X-Forwarded-For. Otherwise the
# Node socket address is used and an inbound X-Forwarded-For is ignored.
PERAGO_TRUST_PROXY=false

# Throwaway local PostgreSQL for `test:db` and fork smoke suites. These suites DROP
# the public schema, so never point this at a database you care about. Example:
# docker run -d --name perago-test-db -e POSTGRES_USER=perago \
#   -e POSTGRES_PASSWORD=<local-password> -e POSTGRES_DB=perago_test \
#   -p 127.0.0.1:56432:5432 postgres:16.10-alpine
# then postgres://perago:<local-password>@127.0.0.1:56432/perago_test
# If Docker reports a forbidden bind, check Windows TCP excluded-port ranges
# (`netsh interface ipv4 show excludedportrange protocol=tcp`) and choose a free port.
# A previously exported TEST_DATABASE_URL overrides Node's --env-file; update
# or clear that shell variable as well when changing the local port.
TEST_DATABASE_URL=

# Optional Foundry binaries when forge/anvil are not on PATH (Windows example:
# C:/Users/<you>/.foundry/bin/forge.exe). Leave empty to use PATH.
FORGE_BIN=
ANVIL_BIN=

# Executor worker (P4-002, `pnpm --filter @perago/executor start`). In a
# deployment these come from the platform secret store, never from a file.
# The executor/session key signs authorize, begin, finalize, and the session
# `perform` UserOperation; it must equal the Wallet Policy's session signer and
# holds only testnet gas. The worker token authenticates /internal/executions;
# the API is configured with its SHA-256. The fork smokes generate both.
PERAGO_EXECUTOR_KEY=
PERAGO_WORKER_TOKEN=
PERAGO_API_URL=
# Optional: RPC for the worker (defaults to PERAGO_BSC_TESTNET_RPC), manifest
# path (defaults to deployments/bsc-testnet.perago.json), and health port.
PERAGO_EXECUTOR_RPC=
PERAGO_DEPLOYMENT_MANIFEST=
PERAGO_EXECUTOR_HEALTH_PORT=

# API server (P7-002): `pnpm --filter @perago/api start` serves the local API.
# The API reads this public executor address only; it never reads PERAGO_EXECUTOR_KEY.
PERAGO_DATABASE_URL=
PERAGO_API_RPC=
PERAGO_EXECUTOR_ADDRESS=
PERAGO_API_VENUE=testnet
PERAGO_API_PORT=8787
PERAGO_WEB_ORIGIN=http://localhost:3000
PERAGO_AUTH_URI=http://127.0.0.1:8787
# `pnpm --filter @perago/api dev:fork` drops the public schema. It accepts
# only a loopback database named `perago_dev`; do not reuse `perago_test` or
# a hosted DB. Use the existing disposable `perago_dev` logical database in
# ONE running PostgreSQL container; host-port differences are not isolation.
# No database URL or password is hardcoded.
PERAGO_DEV_DATABASE_URL=
