{
  "name": "perago",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": "24.21.0",
    "pnpm": "12.4.2"
  },
  "scripts": {
    "build": "turbo run build",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test",
    "lint": "biome check .",
    "test": "turbo run test",
    "toolchain:check": "\"%npm_node_execpath%\" --version && pnpm --version && turbo --version && biome --version && tsc --version && vitest --version",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "turbo": "2.10.13",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
