# Hosted API secrets: copy to $HOME/perago/api.env on the VPS, chmod 600.
# Never commit or paste the populated file. compose.yml already sets the bind
# host, port, venue, trusted-proxy flag, and the testnet-demo manifest.

# Supabase SESSION pooler (port 5432; the VPS is IPv4-only, and the transaction
# pooler breaks the driver's prepared statements). URL-encode the password and
# keep sslmode=verify-full: the image trusts Supabase Root 2021 CA only through
# NODE_EXTRA_CA_CERTS, so an unverified certificate fails the connection.
PERAGO_DATABASE_URL=postgresql://postgres.<project-ref>:<url-encoded-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=verify-full

# Chain-97 node URL (Alchemy). Server-only.
PERAGO_BSC_TESTNET_RPC=
PERAGO_API_RPC=

# Public address of the executor/session key held by worker.env. Not a key.
PERAGO_EXECUTOR_ADDRESS=

# SHA-256 of this value authenticates the worker. Generate 32+ random bytes;
# worker.env carries the same value.
PERAGO_WORKER_TOKEN=

# 64 hex characters. A new key for the hosted database; never reuse the local one.
PERAGO_INTENT_ENCRYPTION_KEY=

# OpenRouter key for the Space Bunny Alpha planner.
PERAGO_OPENROUTER_API_KEY=

# The public web origin (CORS) and the public API URL signed into the wallet
# login message. Both must be the exact HTTPS origins users see.
PERAGO_WEB_ORIGIN=https://<vercel-project>.vercel.app
PERAGO_AUTH_URI=https://perago-api.43-129-38-115.nip.io

# Optional gas sponsorship for the console's root UserOperations. Set both or
# neither (one alone refuses startup). The bundler URL carries an API key.
PERAGO_ALCHEMY_BUNDLER_RPC=
PERAGO_ALCHEMY_GAS_MANAGER_POLICY_ID=

# Optional faucet. Omit PERAGO_FAUCET_KEY to disable it. The key funds only the
# small tBNB budget and is never a deployer, owner, executor, or session key.
PERAGO_FAUCET_KEY=
PERAGO_FAUCET_IP_SALT=
PERAGO_FAUCET_CLAIM_WEI=20000000000000000
PERAGO_FAUCET_FUNDED_THRESHOLD_WEI=50000000000000000
PERAGO_FAUCET_GLOBAL_BUDGET_WEI=1000000000000000000
PERAGO_FAUCET_CLAIM_WINDOW_SECONDS=86400
PERAGO_FAUCET_IP_CLAIM_LIMIT=3
