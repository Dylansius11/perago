# Hosted worker secrets: copy to $HOME/perago/worker.env on the VPS, chmod 600.
# compose.yml sets the API URL, manifest, and health port.

# The executor/session key. It must equal the Wallet Policy's session signer
# and hold only testnet gas. It lives in this file and nowhere else.
PERAGO_EXECUTOR_KEY=

# Same value as PERAGO_WORKER_TOKEN in api.env.
PERAGO_WORKER_TOKEN=

# Chain-97 node URL used to sign and submit. May equal the API's RPC.
PERAGO_BSC_TESTNET_RPC=
PERAGO_EXECUTOR_RPC=
