# Public build-time values for the web client (Vercel project settings).
# Next inlines NEXT_PUBLIC_* into browser code: never put a key or token here.

# The hosted API origin. Locally, leave empty for http://127.0.0.1:8787.
NEXT_PUBLIC_PERAGO_API_URL=https://perago-api.43-129-38-115.nip.io

# Optional chain-97 read RPC. Empty uses the public BSC Testnet default; never
# paste a keyed Alchemy URL here.
NEXT_PUBLIC_PERAGO_RPC_URL=
